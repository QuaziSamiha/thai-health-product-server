//* ============= ADDRESS DOMAIN =============
//* CUSTOMER'S SAVED DELIVERY ADDRESS BOOK — MANAGED FROM THE PROFILE PAGE,
//* INDEPENDENT OF CHECKOUT. Order (order.prisma) IMPORTS THIS VIA
//* OrderAddress, WHICH TAKES A FROZEN SNAPSHOT OF ONE OF THESE ROWS AT
//* PLACEMENT TIME RATHER THAN JOINING IT LIVE — SEE THE OrderAddress
//* COMMENT IN order.prisma.

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id  Int    @id @default(autoincrement())
  sid String @unique @default(uuid()) @db.Uuid

  label     String?     @db.VarChar(100) //* USER-FACING NICKNAME, E.G. "HOME", "OFFICE"
  type      AddressType @default(SHIPPING)
  isDefault Boolean     @default(false) @map("is_default")

  recipientName String  @map("recipient_name") @db.VarChar(200)
  phone         String? @db.VarChar(20) //* NULLABLE — NOT EVERY ACCOUNT (E.G. SOCIAL LOGIN) HAS A PHONE ON FILE TO FALL BACK TO. phone IS MANDATORY AT ORDER PLACEMENT INSTEAD (CreateOrderDto.phone), NOT AT ADDRESS-BOOK SAVE TIME.

  //* THAI ADMINISTRATIVE HIERARCHY, NARROWEST FIRST. THE THREE NAMED LEVELS
  //* ARE THE ONES A THAI COURIER ACTUALLY ROUTES ON AND THE ONES THE CHECKOUT
  //* FORM ASKS FOR — THEY ARE NOT INTERCHANGEABLE WITH THE WESTERN
  //* state/region PAIR THIS MODEL USED BEFORE (MIGRATION
  //* 20260824090000_thai_address_taxonomy).
  addressLine String @map("address_line") @db.VarChar(255) //* HOUSE/UNIT NUMBER, MOO, SOI, STREET, BUILDING — EVERY DETAIL BELOW SUBDISTRICT LEVEL, INCLUDING THE AREA/LANDMARK LINE
  subdistrict String @db.VarChar(100) //* TAMBON (แขวง IN BANGKOK, ตำบล ELSEWHERE) — CHECKOUT'S "SELECT SUB-DISTRICT"
  district    String @db.VarChar(100) //* AMPHOE (เขต IN BANGKOK, อำเภอ ELSEWHERE) — CHECKOUT'S "SELECT DISTRICT"
  province    String @db.VarChar(100) //* CHANGWAT (จังหวัด) — CHECKOUT'S "SELECT PROVINCE"
  postalCode  String @map("postal_code") @db.VarChar(20)
  country     String @default("Thailand") @db.VarChar(100)

  //* RELATIONS
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderAddresses OrderAddress[] //* BEST-EFFORT BACK-LINK — SEE OrderAddress.sourceAddress

  //* TIMESTAMPS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, isDefault])
  @@map("addresses")
}
