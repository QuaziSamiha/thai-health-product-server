model ComboProduct {
  //* SEARCH & IDENTITY
  id  Int    @id @default(autoincrement())
  sid String @unique @default(uuid()) @db.Uuid

  title            String  @unique @db.VarChar(255)
  slug             String  @unique @db.VarChar(255)
  sku              String? @unique @db.VarChar(100)
  barcode          String? @unique @db.VarChar(100)
  description      String? @db.Text
  shortDescription String? @map("short_description") @db.VarChar(500)

  //* CONTENT (TH)
  titleTh       String? @map("title_th") @db.VarChar(255)
  shortDescTh   String? @map("short_desc_th") @db.VarChar(500)
  descriptionTh String? @map("description_th") @db.Text

  //* PRICING (DECIMAL FOR FINANCIAL ACCURACY)
  totalPrice Decimal  @default(0) @map("total_price") @db.Decimal(12, 2) //* SUM-OF-PARTS DISPLAY PRICE
  comboPrice Decimal  @default(0) @map("combo_price") @db.Decimal(12, 2) //* THE BUNDLE OFFER PRICE CUSTOMER PAYS
  costPrice  Decimal? @map("cost_price") @db.Decimal(12, 2) //* LANDED COST OF THE BUNDLE FOR MARGIN REPORTING AGAINST comboPrice — ENTERED, NOT SUMMED FROM ITEMS, SINCE A BUNDLE CARRIES ITS OWN PACKAGING/ASSEMBLY COST

  //* PROMOTION WINDOW (THE "COMBO LIMIT" / DURATION RANGE)
  startsAt DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(3)

  //* STATE
  status     CategoryProductStatus @default(DRAFT)
  isFeatured Boolean               @default(false) @map("is_featured")

  //* AVAILABILITY — THREE DISTINCT NUMBERS, SEE MIGRATION
  //* 20260819160000_combo_available_sold_quantity. A COMBO OWNS NO INVENTORY
  //* OF ITS OWN: IT DRAWS FROM ITS COMPONENTS' STOCK AT CHECKOUT, THE SAME
  //* POOL A DIRECT PRODUCT SALE DRAWS FROM. NOTHING IS EVER RESERVED.
  //*
  //*   sellable = offeredQuantity IS NULL
  //*                ? availableQuantity
  //*                : MIN(availableQuantity, MAX(offeredQuantity - soldQuantity, 0))
  //*
  //* THAT RULE LIVES ONCE, IN THE SQL FUNCTION combo_sellable_quantity(), AND
  //* IS MIRRORED IN ComboProductService — stockStatus, THE STOREFRONT GATE
  //* AND THE ORDER VALIDATOR ALL HAVE TO AGREE ON IT.

  //* FULLY DERIVED — NEVER CLIENT INPUT, NEVER HAND-EDITED. A COMBO IS
  //* ASSEMBLABLE ONLY IF *EVERY* ITEM HAS ENOUGH STOCK, SO THE BUNDLE IS
  //* LIMITED BY ITS SCARCEST PART: A MIN OVER ITEMS, NOT A SUM (UNLIKE
  //* Product.totalStock). DENORMALIZED SO A STOREFRONT LISTING READS ONE
  //* COLUMN INSTEAD OF JOINING combo_items → products/variants AND
  //* AGGREGATING PER CARD. MAINTAINED BY THE TRIGGER FAMILY IN MIGRATION
  //* 20260819160000 AND MIRRORED IN APP CODE AT CREATE TIME
  //* (ComboProductService.resolveComboAvailability) — THE TWO RULES MUST BE
  //* KEPT IN SYNC, SAME CONTRACT AS Product.stockStatus.
  availableQuantity Int @default(0) @map("available_quantity") //* HOW MANY COMPLETE BUNDLES CAN BE ASSEMBLED RIGHT NOW = MIN OVER ITEMS OF floor(ITEM STOCK / ITEM QUANTITY)

  //* THE ADMIN'S CAP ON HOW MANY BUNDLES THIS PROMOTION WILL EVER SELL.
  //* NULL = NO CAP, SELL WHATEVER COMPONENT STOCK ALLOWS.
  offeredQuantity Int? @map("offered_quantity")

  //* BUNDLES CLAIMED BY ORDERS. INCREMENTED IN THE SAME TRANSACTION AS THE
  //* COMPONENT STOCK DEDUCTION AT ORDER PLACEMENT AND DECREMENTED WHEREVER
  //* THAT DEDUCTION IS GIVEN BACK (CANCELLED/FAILED/RETURNED) — SEE
  //* OrderService. BECAUSE THE COMBO HOLDS NO STOCK, THIS IS THE ONLY RECORD
  //* OF HOW FAR A CAPPED OFFER HAS BEEN CONSUMED. ONCE
  //* soldQuantity >= offeredQuantity THE COMBO IS FORCED TO INACTIVE BY
  //* trg_sync_combo_offer_exhaustion.
  soldQuantity Int @default(0) @map("sold_quantity")

  //* DERIVED FROM THE *SELLABLE* NUMBER ABOVE, NOT FROM availableQuantity
  //* ALONE — A SOLD-OUT CAPPED OFFER SITTING ON PLENTY OF COMPONENT STOCK
  //* MUST STILL READ OUT_OF_STOCK, SINCE THIS IS THE ONLY AVAILABILITY SIGNAL
  //* THE PUBLIC SELECT EXPOSES.
  stockStatus       StockStatus @default(OUT_OF_STOCK) @map("stock_status")
  lowStockThreshold Int         @default(10) @map("low_stock_threshold") //* stockStatus BECOMES LOW_STOCK ONCE THE SELLABLE COUNT DROPS TO/BELOW THIS, DOWN TO 1

  //* SEO METADATA
  seoMetadata Json? @default("{}") @map("seo_metadata") //* metaTitle, metaDescription, metaTitleTh, metaDescriptionTh

  //* RELATIONS
  images     ComboImage[]
  items      ComboItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  //* AUDIT & TIMESTAMPS
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3) //* SOFT DELETE
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  createdBy     Int?  @map("created_by")
  createdByUser User? @relation("ComboCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     Int?  @map("updated_by")
  updatedByUser User? @relation("ComboUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  deletedBy     Int?  @map("deleted_by")
  deletedByUser User? @relation("ComboDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@map("combo_products")
}

//* One product (and optional variant) that belongs to a combo, with a quantity.
model ComboItem {
  id Int @id @default(autoincrement())

  comboId Int          @map("combo_id")
  combo   ComboProduct @relation(fields: [comboId], references: [id], onDelete: Cascade)

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict) //* PREVENT DELETING A PRODUCT THAT'S STILL BUNDLED

  variantId Int?            @map("variant_id") //* OPTIONAL: pin to a specific size/variant
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict) //* SAME RULE AS product

  quantity     Int       @default(1)
  unitPrice    Decimal?  @map("unit_price") @db.Decimal(12, 2) //* SNAPSHOT PRICE AT TIME OF BUNDLING (PROTECTS HISTORICAL COMBO PRICING)
  pricedAt     DateTime? @map("priced_at") @db.Timestamptz(3)
  displayOrder Int       @default(0) @map("display_order")

  @@unique([comboId, productId, variantId]) //* PREVENT DUPLICATE ROWS PER (COMBO, PRODUCT, VARIANT)
  @@index([productId])
  @@index([variantId])
  @@map("combo_items")
}

//* Combo-specific imagery, mirrors the structure of ProductImage but scoped to a combo.
model ComboImage {
  id           Int     @id @default(autoincrement())
  url          String  @db.VarChar(512)
  thumbnailUrl String? @map("thumbnail_url") @db.VarChar(512)
  bannerUrl    String? @map("banner_url") @db.VarChar(512)
  iconUrl      String? @map("icon_url") @db.VarChar(512)

  altText      String? @map("alt_text")
  displayOrder Int     @default(0) @map("display_order")
  isPrimary    Boolean @default(false) @map("is_primary") //* AT MOST ONE PER comboId ENFORCED BY A PARTIAL UNIQUE INDEX (combo_images_one_primary_per_combo) — NOT EXPRESSIBLE IN THIS SCHEMA DSL, SEE prisma/migrations/20260802230000_one_primary_image_per_combo
  isActive     Boolean @default(true) @map("is_active")

  comboId Int          @map("combo_id")
  combo   ComboProduct @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@index([comboId, isPrimary])
  @@map("combo_images")
}
