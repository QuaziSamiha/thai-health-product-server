//* ============= USER DOMAIN =============
//* COVERS: AUTHENTICATION, PROFILE, SECURITY, SESSIONS, OTP

enum UserRole {
  ADMIN
  SUPER_ADMIN
  MANAGER
  MARKETING
  SUPPORT
  EMPLOYEE
  VENDOR
  WAREHOUSE
  DELIVERY_PARTNER
  CUSTOMER
  GUEST
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  DEACTIVATED
  ARCHIVED
}

enum OTPType {
  SIGNUP
  PASSWORD_RESET
  LOGIN_2FA
  PHONE_CHANGE
}

model User {
  id       Int     @id @default(autoincrement())
  sid      String  @unique @default(uuid()) @map("user_sid") @db.Uuid // Use native UUID type for performance
  //* NOT @unique HERE — PRISMA'S DSL CAN'T EXPRESS A PARTIAL/FILTERED UNIQUE
  //* INDEX. THE REAL CONSTRAINT IS `users_email_active_key`, A UNIQUE INDEX
  //* SCOPED TO `deleted_at IS NULL` (SEE MIGRATION
  //* 20260813082256_soft_delete_user_email_unique). THIS LETS AN ARCHIVED
  //* ACCOUNT'S EMAIL BE REUSED BY A NEW SIGNUP WITHOUT A UNIQUE-CONSTRAINT
  //* COLLISION. ANY EMAIL LOOKUP MUST FILTER `deletedAt: null` (findFirst,
  //* NOT findUnique) OR IT CAN NON-DETERMINISTICALLY MATCH AN ARCHIVED ROW.
  email    String
  password String? // Null for OAuth
  phone    String? @db.VarChar(20)

  // Enums
  role         UserRole     @default(CUSTOMER)
  status       UserStatus   @default(PENDING_VERIFICATION)
  authProvider AuthProvider @default(EMAIL)
  providerId   String? // OAuth ID

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3) //* FOR SOFT DELETE

  // Relations
  profile                  Profile?
  security                 UserSecurity?
  deliveryManProfile       DeliveryManProfile?
  sessions                 Session[] // Replaces single refreshToken for multi-device support
  otps                     OTP[]
  createdCategories        Category[]              @relation("CategoryCreatedBy")
  updatedCategories        Category[]              @relation("CategoryUpdatedBy")
  createdProducts          Product[]               @relation("ProductCreatedBy")
  updatedProducts          Product[]               @relation("ProductUpdatedBy")
  deletedProducts          Product[]               @relation("ProductDeletedBy")
  inventories              Inventory[]
  createdCombos            ComboProduct[]          @relation("ComboCreatedBy")
  updatedCombos            ComboProduct[]          @relation("ComboUpdatedBy")
  deletedCombos            ComboProduct[]          @relation("ComboDeletedBy")
  blogs                    Blog[]
  createdHomeContents      Home[]                  @relation("HomeCreatedBy")
  updatedHomeContents      Home[]                  @relation("HomeUpdatedBy")
  createdSupports          Support[]               @relation("SupportCreatedBy")
  updatedSupports          Support[]               @relation("SupportUpdatedBy")
  addresses                Address[]
  carts                    Cart[]
  orders                   Order[]
  orderStatusChanges       OrderStatusHistory[]    @relation("OrderStatusChangedBy")
  promoCodeRedemptions     PromoCodeRedemption[]
  createdDeliveryProviders DeliveryProvider[]      @relation("DeliveryProviderCreatedBy")
  updatedDeliveryProviders DeliveryProvider[]      @relation("DeliveryProviderUpdatedBy")
  bookedDeliveryShipments  DeliveryShipment[]      @relation("DeliveryShipmentCreatedBy")
  deliveryStatusChanges    DeliveryStatusHistory[] @relation("DeliveryStatusChangedBy")
  verifiedDeliveryMen      DeliveryManProfile[]    @relation("DeliveryManNidVerifiedBy")

  @@index([email, phone])
  @@map("users")
}

model Profile {
  id          Int       @id @default(autoincrement())
  firstName   String    @db.VarChar(100)
  lastName    String?   @db.VarChar(100)
  name        String?   @db.VarChar(200)
  avatarUrl   String? // One source of truth for the image
  bio         String?   @db.Text
  //* DELIBERATELY *NOT* @db.Timestamptz(3), UNLIKE EVERY OTHER DateTime IN THIS
  //* SCHEMA (SEE MIGRATION 20260802160000_timestamptz_repo_wide): A BIRTH DATE
  //* IS A CALENDAR DATE, NOT AN INSTANT — MAKING IT TZ-AWARE WOULD RENDER IT AS
  //* A DIFFERENT DAY DEPENDING ON THE READER'S ZONE. SHOULD BECOME @db.Date.
  dateOfBirth DateTime?
  gender      String?   @db.VarChar(20)

  metadata Json? @default("{}")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @unique @map("user_id")

  @@index([firstName, lastName])
  @@map("profiles")
}

model UserSecurity {
  id              Int       @id @default(autoincrement())
  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime? @db.Timestamptz(3)

  //* SIGNUP/PASSWORD_RESET/LOGIN_2FA/PHONE_CHANGE VERIFICATION ALL FLOW
  //* THROUGH THE `OTP` MODEL — NO PARALLEL TOKEN MECHANISM HERE. (A PRIOR
  //* verificationToken/resetToken PAIR WAS REMOVED IN MIGRATION
  //* 20260813085902_drop_unused_user_security_tokens: DECLARED BUT NEVER
  //* READ OR WRITTEN BY ANY REPOSITORY, AND — UNLIKE `OTP` — COULD ONLY HOLD
  //* ONE LIVE TOKEN AT A TIME, WITH NO HISTORY OF PRIOR REQUESTS.)

  // Security Logs
  loginAttempts Int     @default(0)
  lastLoginIp   String?
  assignedIp    String? // For internal/vendor restricted access

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @unique @map("user_id")

  @@map("user_security")
}

model Session {
  id                    Int      @id @default(autoincrement())
  refreshToken          String   @unique @db.Text
  refreshTokenExpiresAt DateTime @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  userAgent             String?
  ipAddress             String?

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@map("sessions")
}

model OTP {
  id        Int      @id @default(autoincrement())
  code      String // Hashed code for security
  type      OTPType
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  isUsed    Boolean  @default(false) @map("is_used")

  // To identify the target
  identifier String // * email or phone number

  userId Int?  @map("user_id") // Optional for guest checkouts
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("otps")
}
