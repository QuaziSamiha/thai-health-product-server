//* ============= PARTNER DOMAIN =============
//* "BECOME A PARTNER" ENQUIRIES SUBMITTED FROM THE PUBLIC SITE (HEADER
//* BUTTON → MODAL FORM). ANONYMOUS VISITORS CAN SUBMIT, SO THERE IS NO User
//* RELATION. ADMINS REVIEW THE LIST AND MOVE EACH ROW THROUGH `status`.

//* SHARED STATUS FOR THE ADMIN-MANAGED DROPDOWN TABLES (PartnerType, PartnerCountry)
enum PartnerOptionStatus {
  ACTIVE //* SHOWN ON THE PUBLIC FORM
  INACTIVE //* HIDDEN FROM THE FORM, STILL LISTED IN ADMIN
  ARCHIVED //* SOFT DELETED — HIDDEN FROM THE FORM AND THE DEFAULT ADMIN LIST
}

//* PARTNER TYPE OPTIONS SHOWN IN THE FORM'S "TYPE" DROPDOWN — MANAGED BY
//* ADMIN. ONLY ACTIVE ROWS ARE SHOWN ON THE PUBLIC FORM.
model PartnerType {
  id  Int    @id @default(autoincrement())
  sid String @unique @default(uuid()) @db.Uuid

  name   String              @unique @db.VarChar(100) //* E.G. "Distributor", "Pharmacy"
  status PartnerOptionStatus @default(ACTIVE)

  partnerRequests PartnerRequest[]

  //* AUDIT TRAIL — ADMIN WHO CREATED / LAST UPDATED THIS TYPE
  createdBy     Int?  @map("created_by")
  createdByUser User? @relation("PartnerTypeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     Int?  @map("updated_by")
  updatedByUser User? @relation("PartnerTypeUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  //* TIMESTAMPS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("partner_types")
}

//* COUNTRY OPTIONS SHOWN IN THE FORM'S "COUNTRY" DROPDOWN — MANAGED BY
//* ADMIN. ONLY ACTIVE ROWS ARE SHOWN ON THE PUBLIC FORM.
model PartnerCountry {
  id  Int    @id @default(autoincrement())
  sid String @unique @default(uuid()) @db.Uuid

  name   String              @unique @db.VarChar(100) //* E.G. "Thailand"
  status PartnerOptionStatus @default(ACTIVE)

  partnerRequests PartnerRequest[]

  //* AUDIT TRAIL — ADMIN WHO CREATED / LAST UPDATED THIS COUNTRY
  createdBy     Int?  @map("created_by")
  createdByUser User? @relation("PartnerCountryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     Int?  @map("updated_by")
  updatedByUser User? @relation("PartnerCountryUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  //* TIMESTAMPS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("partner_countries")
}

enum PartnerRequestStatus {
  PENDING //* JUST SUBMITTED, NOT YET LOOKED AT
  CONTACTED //* ADMIN HAS REACHED OUT
  APPROVED
  REJECTED
  ARCHIVED //* SOFT DELETED — READ-ONLY FROM HERE ON
}

model PartnerRequest {
  id  Int    @id @default(autoincrement())
  sid String @unique @default(uuid()) @db.Uuid

  //* FORM FIELDS
  name        String  @db.VarChar(150)
  companyName String  @map("company_name") @db.VarChar(200)
  message     String? @db.Text

  //* RELATIONS
  partnerTypeId Int         @map("partner_type_id")
  partnerType   PartnerType @relation(fields: [partnerTypeId], references: [id], onDelete: Restrict) //* CAN'T DELETE A TYPE THAT HAS REQUESTS — DEACTIVATE IT INSTEAD

  partnerCountryId Int            @map("partner_country_id")
  partnerCountry   PartnerCountry @relation(fields: [partnerCountryId], references: [id], onDelete: Restrict) //* SAME RULE — SET INACTIVE INSTEAD OF DELETING

  //* ADMIN WORKFLOW
  status PartnerRequestStatus @default(PENDING)

  //* TIMESTAMPS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([partnerTypeId])
  @@index([partnerCountryId])
  @@map("partner_requests")
}
