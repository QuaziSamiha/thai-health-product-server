enum SupportStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum SupportType {
  DELIVERY_POLICY
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  CANCELLATION_POLICY
  RETURN_POLICY
  OTHERS //* CATCH-ALL FOR ANY POLICY/INFO PAGE NOT COVERED ABOVE
}

model Support {
  id   Int         @id @default(autoincrement())
  sid  String      @unique @default(uuid()) @db.Uuid //* USE NATIVE UUID TYPE FOR PERFORMANCE
  type SupportType

  //* AT MOST ONE ACTIVE ROW PER NAMED TYPE IS ENFORCED BY THE DB-ONLY PARTIAL
  //* UNIQUE INDEX `support_pages_active_type_key` (`type` WHERE status = ACTIVE
  //* AND type <> OTHERS), ADDED IN 20260818103000_support_one_active_page_per_type.
  //* PRISMA'S DSL CANNOT EXPRESS A FILTERED UNIQUE INDEX, SO THERE IS DELIBERATELY
  //* NO @@unique HERE — SAME TRADE-OFF AS users_email_active_key. `OTHERS` IS
  //* EXCLUDED: IT IS THE CATCH-ALL TYPE AND MAY HOLD MANY ACTIVE ROWS AT ONCE.
  status SupportStatus @default(ACTIVE)

  //* PRIMARY CONTENT (ENGLISH & GLOBAL SLUG)
  title   String  @db.VarChar(255)
  slug    String  @unique @db.VarChar(255) //* ROUTE/URL IDENTIFIER, ALSO DISAMBIGUATES MULTIPLE `OTHERS` ROWS
  content String  @db.Text
  note    String? @db.Text //* EXTRA NOTE / DISCLAIMER RENDERED BELOW THE MAIN CONTENT

  //* SECONDARY CONTENT (THAI DISPLAY ONLY)
  titleTh   String? @db.VarChar(255)
  contentTh String? @db.Text
  noteTh    String? @db.Text

  //* AUDIT TRAIL & TIMESTAMPS
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  //* RELATIONS
  createdBy     Int?
  createdByUser User? @relation("SupportCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     Int?
  updatedByUser User? @relation("SupportUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  //* INDEXING STRATEGY
  @@index([slug]) //* PRIMARY INDEX FOR URL LOOKUPS
  @@index([type, status]) //* FAST FETCHING OF THE ACTIVE PAGE FOR A GIVEN TAB
  @@map("support_pages")
}
