//* ============= PRODUCT DOMAIN =============
//* COVERS: PRODUCT, VARIANTS, IMAGES
//* CategoryProductStatus IS SHARED WITH category.prisma — DEFINED IN shared.prisma

enum ProductType {
  SIMPLE
  VARIABLE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
}

model Product {
  //* SEARCH & IDENTITY
  id  Int    @id @default(autoincrement())
  sid String @unique @default(uuid()) @db.Uuid //* Use native UUID type for performance

  //* PRIMARY CONTENT (ENGLISH & GLOBAL SLUG)
  name             String  @unique @db.VarChar(255)
  slug             String  @unique @db.VarChar(255)
  sku              String? @unique @db.VarChar(100)
  barcode          String? @unique @db.VarChar(100)
  description      String? @db.Text
  shortDescription String? @map("short_description") @db.VarChar(500) // Restricted for UI consistency

  //* SECONDARY CONTENT (THAI DISPLAY)
  nameTh        String? @map("name_th") @db.VarChar(255)
  descriptionTh String? @map("description_th") @db.Text
  shortDescTh   String? @map("short_desc_th") @db.VarChar(500)

  //* CONFIGURATIONS
  type          ProductType           @default(SIMPLE)
  status        CategoryProductStatus @default(ACTIVE)
  isFeatured    Boolean               @default(false) @map("is_featured")
  hasVariants   Boolean               @default(false) @map("has_variants") //* DERIVED FIELD TO READ FASTER (variants.length)
  comboQuantity Int                   @default(1) @map("combo_quantity") //* HOW MANY UNITS OF THIS PRODUCT GO INTO A COMBO. USED TO PREFILL ComboItem.quantity WHEN THIS PRODUCT IS BUNDLED — ComboItem.quantity STAYS AUTHORITATIVE PER COMBO AND MAY OVERRIDE IT. MUST BE > 0 (products_combo_quantity_positive).

  //* PRICING (USE DECIMAL FOR FINANCIAL ACCURACY)
  costPrice     Decimal?     @map("cost_price") @db.Decimal(12, 2) //* FOR PROFIT CALCULATION
  discountType  DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal?     @map("discount_value") @db.Decimal(12, 2) //* THE RAW CONFIGURED DISCOUNT — FIXED AMOUNT OR PERCENTAGE, PAIRED WITH discountType
  basePrice     Decimal      @default(0) @map("base_price") @db.Decimal(12, 2)
  salePrice     Decimal      @default(0) @map("sale_price") @db.Decimal(12, 2) //* SERVER-DERIVED FROM basePrice + discountType/discountValue — NEVER CLIENT INPUT

  //* STOCK
  quantity          Int         @default(0) // * TOTAL QUANTITY OF A PRODUCT WITHOUT VARIANTS
  totalStock        Int         @default(0) @map("total_stock") // * TOTAL QUANTITY ACROSS ALL VARIANTS -- Denormalized cache: Represents sum of all variant stock. Must be kept in sync via application logic or DB trigger.
  stockStatus       StockStatus @default(OUT_OF_STOCK) @map("stock_status")
  lowStockThreshold Int         @default(10) @map("low_stock_threshold") //* stockStatus BECOMES LOW_STOCK ONCE THE EFFECTIVE COUNT (quantity FOR SIMPLE, totalStock FOR VARIABLE) DROPS TO/BELOW THIS, DOWN TO 1. KEPT IN SYNC VIA THE SAME DB TRIGGERS AS stockStatus.

  // * PHYSICAL
  weight     Decimal? @db.Decimal(10, 3) //* WEIGHT IN KG
  dimensions Json?    @default("{}") //* STRUCTURED (LENGTH, WIDTH, HEIGHT)
  size       String?  @db.VarChar(50) //* ONLY MEANINGFUL FOR type = SIMPLE — VARIABLE PRODUCTS EXPRESS SIZE PER VARIANT INSTEAD (SEE ProductVariant.size)

  //* SEO METADATA
  seoMetadata Json? @default("{}") @map("seo_metadata") //* Consolidating SEO fields for cleaner API: metaTitle,  metaDescription, metaTitleTh, metaDescriptionTh

  tags String[] //* POSTGRES NATIVE ARRAY SUPPORT

  //* HEALTH & COMPLIANCE LABELING (SUPPLEMENT/HEALTH PRODUCT INFO) — CUSTOMER-VISIBLE
  dosage                String? @db.Text
  dosageTh              String? @map("dosage_th") @db.Text
  ingredients           String? @db.Text
  ingredientsTh         String? @map("ingredients_th") @db.Text
  healthBenefits        String? @map("health_benefits") @db.Text
  healthBenefitsTh      String? @map("health_benefits_th") @db.Text
  warning               String? @db.Text
  warningTh             String? @map("warning_th") @db.Text
  storageInstructions   String? @map("storage_instructions") @db.Text
  storageInstructionsTh String? @map("storage_instructions_th") @db.Text
  origin                String? @db.VarChar(255)
  genericName           String? @map("generic") @db.VarChar(255)

  //* RELATIONS
  categoryId    Int              @map("category_id")
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  inventoryLogs Inventory[]
  batches       Batch[]
  comboItems    ComboItem[]

  //* AUDIT & TIMESTAMPS
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3) //* FOR SOFT DELETE
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3) //* This allows for scheduled launches draft vs live

  createdBy     Int?  @map("created_by")
  createdByUser User? @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     Int?  @map("updated_by")
  updatedByUser User? @relation("ProductUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  deletedBy     Int?  @map("deleted_by")
  deletedByUser User? @relation("ProductDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([status, stockStatus]) //* Admin dashboard: active products that are low/out of stock
  @@index([status, type, publishedAt]) //* Fast filtering for shop listing
  @@index([categoryId, status]) //* Optimized category browsing
  @@index([status, isFeatured]) //* Homepage performance
  @@index([createdAt]) //* Sorting by "Newest"
  @@index([tags], type: Gin, map: "products_tags_gin_idx") //* Fast tags @> ARRAY[...] filtering
  @@map("products")
}

model ProductVariant {
  id               Int     @id @default(autoincrement())
  //* PRIMARY CONTENT (ENGLISH & GLOBAL SLUG)
  name             String  @unique @db.VarChar(255)
  slug             String  @unique @db.VarChar(255)
  description      String? @db.Text
  shortDescription String? @map("short_description") @db.Text

  //* SECONDARY CONTENT (THAI DISPLAY)
  nameTh        String? @map("name_th") @db.VarChar(255)
  descriptionTh String? @map("description_th") @db.Text
  shortDescTh   String? @map("short_desc_th") @db.Text

  //* STOCK & LOGISTICS
  sku               String?     @unique @db.VarChar(100)
  barcode           String?     @unique @db.VarChar(100)
  quantity          Int         @default(0)
  stockStatus       StockStatus @default(OUT_OF_STOCK) @map("stock_status")
  lowStockThreshold Int         @default(10) @map("low_stock_threshold") //* SAME SEMANTICS AS Product.lowStockThreshold, SCOPED TO THIS VARIANT'S OWN quantity
  weight            Decimal?    @db.Decimal(10, 3) //* WEIGHT IN KG
  size              String?     @db.VarChar(50) // * PRODUCT WITHOUT VARIANTS

  //* PRICING (SAME SHAPE AS Product — SEE Product's OWN PRICING BLOCK ABOVE)
  costPrice     Decimal?     @map("cost_price") @db.Decimal(12, 2) //* FOR PROFIT CALCULATION
  discountType  DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal?     @map("discount_value") @db.Decimal(12, 2) //* THE RAW CONFIGURED DISCOUNT — FIXED AMOUNT OR PERCENTAGE, PAIRED WITH discountType
  basePrice     Decimal      @default(0) @map("base_price") @db.Decimal(12, 2)
  salePrice     Decimal      @default(0) @map("sale_price") @db.Decimal(12, 2) //* SERVER-DERIVED FROM basePrice + discountType/discountValue — NEVER CLIENT INPUT

  attributes    Json    @default("{}") // The JSON structure for attributes (e.g., {"color": "Red", "size": "XL"})  //* E.G. { "size": "500ml", "flavor": "Honey" }
  isDefault     Boolean @default(false) @map("is_default")
  comboQuantity Int     @default(1) @map("combo_quantity") //* SAME SEMANTICS AS Product.comboQuantity, SCOPED TO THIS VARIANT — WINS OVER THE PARENT PRODUCT'S VALUE WHEN A ComboItem PINS A VARIANT. MUST BE > 0 (product_variants_combo_quantity_positive).

  // * RELATIONS
  productId     Int            @map("product_id")
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  inventoryLogs Inventory[]
  batches       Batch[]
  comboItems    ComboItem[]

  @@index([productId])
  @@index([productId, isDefault]) //* FETCH THE DEFAULT VARIANT FAST
  @@index([productId, stockStatus]) //* Admin dashboard: this product's low/out-of-stock variants
  @@map("product_variants")
}

model ProductImage {
  id           Int     @id @default(autoincrement())
  url          String  @db.VarChar(512)
  //* OPTIMIZED IMAGES
  thumbnailUrl String? @map("thumbnail_url") @db.VarChar(512)
  bannerUrl    String? @map("banner_url") @db.VarChar(512)
  iconUrl      String? @map("icon_url") @db.VarChar(512)

  altText      String? @map("alt_text")
  displayOrder Int     @default(0) @map("display_order")
  isPrimary    Boolean @default(false) @map("is_primary") //* AT MOST ONE PER productId ENFORCED BY A PARTIAL UNIQUE INDEX (product_images_one_primary_per_product) — NOT EXPRESSIBLE IN THIS SCHEMA DSL, SEE prisma/migrations/20260719170000_one_primary_image_per_product
  isActive     Boolean @default(true) @map("is_active")

  // * RELATIONS
  productId Int             @map("product_id")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?            @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, isPrimary])
  @@index([variantId])
  @@map("product_images")
}
