//* ============= CATEGORY DOMAIN =============
//* CategoryProductStatus IS SHARED WITH product.prisma — DEFINED IN shared.prisma

model Category {
  id     Int                   @id @default(autoincrement())
  sid    String                @unique @default(uuid()) @db.Uuid // * Use native UUID type for performance
  status CategoryProductStatus @default(ACTIVE)

  //* PRIMARY CONTENT (ENGLISH & GLOBAL SLUG)
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255) //* GLOBAL SEARCH IDENTIFIER
  description String? @db.Text

  //* SECONDARY CONTENT (THAI DISPLAY ONLY)
  nameTh        String? @db.VarChar(255)
  descriptionTh String? @db.Text

  //* HIERARCHY MANAGEMENT
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction)
  children Category[] @relation("CategoryHierarchy")
  level    Int        @default(0)

  //* OPTIMIZED IMAGES
  thumbnailUrl String? @db.VarChar(512)
  bannerUrl    String? @db.VarChar(512)
  iconUrl      String? @db.VarChar(512)

  //* UI & SEO METADATA
  displayOrder Int     @default(0)
  isFeatured   Boolean @default(false)
  productCount Int     @default(0) //* LIVE, TRIGGER-MAINTAINED SUBTREE ROLLUP: COUNT OF EVERY SELLABLE PRODUCT (status = ACTIVE AND deletedAt IS NULL — ProductRepository.activeVisibilityWhere()) FILED UNDER THIS CATEGORY *OR ANY DESCENDANT OF IT*. A ROOT THEREFORE REPORTS ITS WHOLE BRANCH, WHICH IS THE ONLY USEFUL NUMBER FOR IT SINCE PRODUCTS MAY NEVER BE FILED ON A ROOT DIRECTLY. A DESCENDANT'S OWN status IS NOT CONSIDERED — THE ADMIN LISTING READS THIS COLUMN TOO AND NEEDS THE TRUE TALLY. NEVER WRITTEN BY APP CODE. SEE 20260818110000_maintain_category_product_count.

  metaTitle         String? @db.VarChar(255)
  metaDescription   String? @db.Text
  metaTitleTh       String? @db.VarChar(255)
  metaDescriptionTh String? @db.Text

  //* AUDIT TRAIL & TIMESTAMPS
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  //* RELATINOS
  createdBy     Int?
  createdByUser User?     @relation("CategoryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     Int?
  updatedByUser User?     @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  products      Product[]

  //* INDEXING STRATEGY
  //* NO @@index([slug]) — `slug @unique` ABOVE ALREADY CREATES A BTREE INDEX
  //* THAT SERVES EVERY URL LOOKUP. A SECOND ONE IS PURE WRITE AMPLIFICATION.
  @@index([parentId, status]) //* FAST FETCHING OF ACTIVE SUB-CATEGORIES
  @@index([status, isFeatured]) //* FAST FETCHING FOR "FEATURED" HOMEPAGE SECTIONS
  @@index([displayOrder]) //* OPTIMIZED SORTING FOR MENUS/LISTS
  @@map("categories")
}
