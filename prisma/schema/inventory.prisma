//* ============= INVENTORY/STOCK DOMAIN =============

enum InventoryExchangeType {
  ADD
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  EXPIRED
}

// ============= BATCH MANAGEMENT MODEL =============
model Batch {
  id  Int    @id @default(autoincrement())
  sid String @unique @default(uuid()) @db.Uuid

  batchNo String @unique @map("batch_no") @db.VarChar(100) // HUMAN READABLE BATCH NUMBER (E.G., 14-BEAUTY-001)

  // QUANTITIES
  quantity  Int @default(0) // INITIAL QUANTITY ADDED IN THIS BATCH
  remaining Int @default(0) // QUANTITY REMAINING (DECREMENTS ON REMOVAL)

  //* PRICING
  costPrice Decimal @default(0) @map("cost_price") @db.Decimal(12, 2) //* COST PRICE PAID PER UNIT TO ACQUIRE THIS BATCH — SNAPSHOT AT RECEIPT TIME, USED FOR COGS/FIFO VALUATION. DISTINCT FROM Inventory.costPrice, WHICH IS A PER-MOVEMENT SNAPSHOT, NOT PER-BATCH.

  // METADATA FOR THE BATCH
  manufacturingDate DateTime? @map("manufacturing_date") @db.Timestamptz(3)
  expiryDate        DateTime? @map("expiry_date") @db.Timestamptz(3)

  // TIME STAMPS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // RELATIONS
  productId Int?            @map("product_id")
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?            @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("batches")
}

model Inventory {
  id                  Int                   @id @default(autoincrement())
  sid                 String                @unique @default(uuid()) @db.Uuid
  quantity            Int                   @default(0)
  changeType          InventoryExchangeType @default(ADD) @map("change_type")
  reason              String?               @db.Text
  referenceId         String?               @map("reference_id") // Reference to order, purchase, etc.
  costPrice           Decimal?              @map("cost_price") // Cost at time of stock change
  sellingPrice        Decimal?              @map("selling_price") // Selling price at time of stock change
  // * TIME STAMPS
  recordedAt          DateTime              @default(now()) @map("recorded_at") @db.Timestamptz(3)
  // * RELATIONS
  productId           Int?                  @map("product_id")
  product             Product?              @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId           Int?                  @map("variant_id")
  variant             ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  recordedBy          Int?                  @map("recorded_by")
  InventoryRecordedBy User?                 @relation(fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([changeType])
  //* CANCELLING/FAILING AN ORDER REVERSES ITS SALE MOVEMENTS BY LOOKING THEM
  //* UP AS (referenceId = "order:<id>", changeType IN (SALE, RETURN)) — SEE
  //* InventoryService.restoreStockForOrder. WITHOUT THIS THAT IS A SEQ SCAN
  //* OVER THE WHOLE LEDGER, WHICH GROWS WITH EVERY STOCK MOVEMENT EVER MADE.
  @@index([referenceId, changeType])
  @@map("inventory")
}
